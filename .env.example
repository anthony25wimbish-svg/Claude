# Copy this file to .env (or set these as real environment variables) to run the
# TradingView MCP server with an authenticated session.
#
# How to get these values:
#   1. Log in to https://www.tradingview.com in your browser.
#   2. Open DevTools -> Application/Storage -> Cookies -> https://www.tradingview.com
#   3. Copy the values of the "sessionid" and "sessionid_sign" cookies below.
#
# Treat these like a password: anyone with them can act as your TradingView account.
# Never commit a real .env file.

TRADINGVIEW_SESSION_ID=
TRADINGVIEW_SESSION_ID_SIGN=
